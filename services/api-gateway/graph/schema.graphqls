# User type
type User {
  id: ID!
  name: String!
  email: String!
  publicName: String
  isAdmin: Boolean!
  isBlocked: Boolean!
  phoneNumber: String
  position: String
  emailVerified: Boolean!
  emailVerifiedAt: Int
  lastLoginAt: Int
  createdAt: Int
  updatedAt: Int
  avatar: Media
}

# Upload scalar for file uploads
scalar Upload

# Product type
type Product {
  id: ID!
  name: String!
  slug: String!
  description: String
  metadata: String
  features: String
  isPopular: Boolean!
  isDefault: Boolean!
  createdAt: Int!
  updatedAt: Int!
}

# Plan type
type Plan {
  id: ID!
  name: String!
  slug: String!
  intervalId: ID!
  productId: ID!
  isActive: Boolean!
  hasTrial: Boolean!
  trialIntervalId: ID
  intervalCount: Int!
  trialIntervalCount: Int
  description: String
  type: String!
  maxUsersPerTenant: Int
  meterId: ID
  isVisible: Boolean!
  createdAt: Int!
  updatedAt: Int!
}

# Tenant type
type Tenant {
  id: ID!
  uuid: String!
  name: String!
  slug: String!
  domain: String
  isNameAutoGenerated: Boolean!
  createdBy: ID!
  createdAt: Int!
  updatedAt: Int!
}

# TenantUser type
type TenantUser {
  id: ID!
  userId: ID!
  tenantId: ID!
  role: String!
  isDefault: Boolean!
  email: String!
  createdAt: Int!
  updatedAt: Int!
}

# TenantSetting type
type TenantSetting {
  id: ID!
  tenantId: ID!
  key: String!
  value: String!
  createdAt: Int!
  updatedAt: Int!
}

# Media type
type Media {
  id: ID!
  modelType: String!
  modelId: ID!
  uuid: String!
  collectionName: String!
  name: String!
  fileName: String!
  mimeType: String
  disk: String!
  conversionsDisk: String
  size: Int!
  manipulations: String!
  customProperties: String!
  generatedConversions: String!
  responsiveImages: String!
  orderColumn: Int
  isPublic: Boolean!
  publicUrl: String
  url: String
  createdAt: Int!
  updatedAt: Int!
}

type MediaListData {
  media: [Media!]!
  total: Int!
  page: Int!
  perPage: Int!
}

type MediaResponse {
  success: Boolean!
  message: String!
  data: Media
}

type MediaListResponse {
  success: Boolean!
  message: String!
  data: MediaListData
}

type DeleteMediaResponse {
  success: Boolean!
  message: String!
}

type MediaURLData {
  url: String!
  expiresAt: Int!
}

type MediaURLResponse {
  success: Boolean!
  message: String!
  data: MediaURLData
}

# Blog Post type
type BlogPost {
  id: ID!
  title: String!
  slug: String!
  body: String!
  isPublished: Boolean!
  publishedAt: Int
  userId: ID!
  authorId: ID
  blogPostCategoryId: ID
  description: String
  createdAt: Int!
  updatedAt: Int!
  author: User
  category: Category
  featuredImage: Media
}

# Category type
type Category {
  id: ID!
  name: String!
  slug: String!
  description: String
  createdAt: Int!
  updatedAt: Int!
}

# Blog Post list response
type BlogPostList {
  blogPosts: [BlogPost!]!
  total: Int!
  page: Int!
  perPage: Int!
}

# Category list response
type CategoryList {
  categories: [Category!]!
  total: Int!
  page: Int!
  perPage: Int!
}

# Blog Post response wrappers
type BlogPostResponse {
  success: Boolean!
  message: String!
  data: BlogPost
}

type BlogPostListResponse {
  success: Boolean!
  message: String!
  data: BlogPostList
}

type DeleteBlogPostResponse {
  success: Boolean!
  message: String!
}

# Category response wrappers
type CategoryResponse {
  success: Boolean!
  message: String!
  data: Category
}

type CategoryListResponse {
  success: Boolean!
  message: String!
  data: CategoryList
}

type DeleteCategoryResponse {
  success: Boolean!
  message: String!
}

# Announcement type
type Announcement {
  id: ID!
  title: String!
  content: String!
  startsAt: Int
  endsAt: Int
  isActive: Boolean!
  isDismissible: Boolean!
  showForCustomers: Boolean!
  showOnFrontend: Boolean!
  showOnUserDashboard: Boolean!
  createdAt: Int!
  updatedAt: Int!
}

# Announcement list response
type AnnouncementList {
  announcements: [Announcement!]!
  total: Int!
  page: Int!
  perPage: Int!
}

# Announcement response wrappers
type AnnouncementResponse {
  success: Boolean!
  message: String!
  data: Announcement
}

type AnnouncementListResponse {
  success: Boolean!
  message: String!
  data: AnnouncementList
}

type DeleteAnnouncementResponse {
  success: Boolean!
  message: String!
}

type ActiveAnnouncementsResponse {
  success: Boolean!
  message: String!
  data: [Announcement!]
}

