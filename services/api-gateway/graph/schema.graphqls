# Discount type
type Discount {
  id: ID!
  name: String!
  description: String
  type: String!
  amount: Float!
  validUntil: Int
  isActive: Boolean!
  actionType: String
  maxRedemptions: Int
  maxRedemptionsPerUser: Int
  redemptions: Int!
  isRecurring: Boolean!
  durationInMonths: Int
  maximumRecurringIntervals: Int
  redeemType: Int
  bonusDays: Int
  isEnabledForAllPlans: Boolean!
  isEnabledForAllOneTimeProducts: Boolean!
  createdAt: Int!
  updatedAt: Int!
}

# Discount list response
type DiscountList {
  discounts: [Discount!]!
  total: Int!
  page: Int!
  perPage: Int!
}

type DiscountResponse {
  success: Boolean!
  message: String!
  data: Discount
}

type DiscountListResponse {
  success: Boolean!
  message: String!
  data: DiscountList
}

type DeleteDiscountResponse {
  success: Boolean!
  message: String!
}

# Input types
input LoginInput {
  email: String!
  password: String!
}

input RefreshTokenInput {
  refreshToken: String!
}

input CreateUserInput {
  name: String!
  email: String!
  password: String!
  publicName: String
  phoneNumber: String
  position: String
  isAdmin: Boolean
}

input UpdateUserInput {
  id: ID!
  name: String!
  email: String
  publicName: String
  phoneNumber: String
  position: String
  isAdmin: Boolean
  isBlocked: Boolean
}

input ChangePasswordInput {
  oldPassword: String!
  newPassword: String!
}

input ResetPasswordInput {
  token: String!
  newPassword: String!
}

input CreateTenantInput {
  name: String!
  slug: String
  domain: String
}

input UpdateTenantInput {
  id: ID!
  name: String!
  domain: String
}

input AddUserToTenantInput {
  userId: ID!
  tenantId: ID!
  role: String!
  isDefault: Boolean
}

input UpdateUserRoleInput {
  userId: ID!
  tenantId: ID!
  role: String!
}

input SetDefaultTenantInput {
  userId: ID!
  tenantId: ID!
}

input SetSettingInput {
  tenantId: ID!
  key: String!
  value: String!
}

input CreateProductInput {
  name: String!
  slug: String
  description: String
  metadata: String
  features: String
  isPopular: Boolean
  isDefault: Boolean
}

input UpdateProductInput {
  id: ID!
  name: String!
  slug: String
  description: String
  metadata: String
  features: String
  isPopular: Boolean
  isDefault: Boolean
}

input UploadFileInput {
  content: Upload!
  fileName: String!
  mimeType: String!
  modelType: String!
  modelId: ID!
  collectionName: String!
  name: String
  disk: String!
  isPublic: Boolean
}

input GetFilesByModelInput {
  modelType: String!
  modelId: ID!
  collectionName: String
  page: Int
  perPage: Int
}

input GetAllMediaInput {
  page: Int
  perPage: Int
  modelType: String
  collectionName: String
}

input CreatePlanInput {
  name: String!
  slug: String
  intervalId: ID!
  productId: ID!
  isActive: Boolean
  hasTrial: Boolean
  trialIntervalId: ID
  intervalCount: Int!
  trialIntervalCount: Int
  description: String
  type: String!
  maxUsersPerTenant: Int
  meterId: ID
  isVisible: Boolean
}

input UpdatePlanInput {
  id: ID!
  name: String!
  slug: String
  intervalId: ID!
  isActive: Boolean
  hasTrial: Boolean
  trialIntervalId: ID
  intervalCount: Int!
  trialIntervalCount: Int
  description: String
  type: String!
  maxUsersPerTenant: Int
  meterId: ID
  isVisible: Boolean
}

input CreateDiscountInput {
  name: String!
  description: String
  type: String!
  amount: Float!
  validUntil: Int
  isActive: Boolean!
  actionType: String
  maxRedemptions: Int
  maxRedemptionsPerUser: Int
  isRecurring: Boolean!
  durationInMonths: Int
  maximumRecurringIntervals: Int
  redeemType: Int
  bonusDays: Int
  isEnabledForAllPlans: Boolean
  isEnabledForAllOneTimeProducts: Boolean
}

input UpdateDiscountInput {
  id: ID!
  name: String!
  description: String
  type: String!
  amount: Float!
  validUntil: Int
  isActive: Boolean!
  actionType: String
  maxRedemptions: Int
  maxRedemptionsPerUser: Int
  isRecurring: Boolean!
  durationInMonths: Int
  maximumRecurringIntervals: Int
  redeemType: Int
  bonusDays: Int
  isEnabledForAllPlans: Boolean
  isEnabledForAllOneTimeProducts: Boolean
}

# Blog Post inputs
input CreateBlogPostInput {
  title: String!
  slug: String
  body: String!
  description: String
  userId: ID!
  authorId: ID
  blogPostCategoryId: ID
  isPublished: Boolean
  publishedAt: Int
}

input UpdateBlogPostInput {
  id: ID!
  title: String!
  slug: String!
  body: String!
  description: String
  authorId: ID
  blogPostCategoryId: ID
  isPublished: Boolean
  publishedAt: Int
}

# Category inputs
input CreateCategoryInput {
  name: String!
  slug: String
  description: String
}

input UpdateCategoryInput {
  id: ID!
  name: String!
  slug: String!
  description: String
}

# Announcement inputs
input CreateAnnouncementInput {
  title: String!
  content: String!
  startsAt: Int
  endsAt: Int
  isActive: Boolean
  isDismissible: Boolean
  showForCustomers: Boolean
  showOnFrontend: Boolean
  showOnUserDashboard: Boolean
}

input UpdateAnnouncementInput {
  id: ID!
  title: String!
  content: String!
  startsAt: Int
  endsAt: Int
  isActive: Boolean
  isDismissible: Boolean
  showForCustomers: Boolean
  showOnFrontend: Boolean
  showOnUserDashboard: Boolean
}

# Queries
type Query {
  # Get user by ID
  user(id: ID!): UserResponse!

  # Get all users with pagination
  users(page: Int, perPage: Int): UserListResponse!

  # Media queries
  media(id: ID!): MediaResponse!
  mediaByUUID(uuid: String!): MediaResponse!
  mediaByModel(input: GetFilesByModelInput!): MediaListResponse!
  allMedia(input: GetAllMediaInput): MediaListResponse!
  mediaURL(id: ID!, expirySeconds: Int): MediaURLResponse!

  # Search users by name or email
  searchUsers(query: String!, page: Int, perPage: Int): UserListResponse!

  # Get current user (requires auth header)
  me: UserResponse!

  # Verify reset password token
  verifyResetToken(token: String!): ForgotPasswordResponse!

  # Tenant queries (admin only)
  tenant(id: ID!): TenantResponse!
  tenantBySlug(slug: String!): TenantResponse!
  tenants(
    page: Int
    perPage: Int
    search: String
    sortBy: String
    sortOrder: String
  ): TenantListResponse!
  tenantUsers(tenantId: ID!): TenantUsersResponse!
  userTenants(userId: ID!): TenantUsersResponse!

  # Tenant settings queries
  tenantSetting(tenantId: ID!, key: String!): TenantSettingResponse!
  tenantSettings(tenantId: ID!): TenantSettingsResponse!

  # Product queries
  product(id: ID!): ProductResponse!
  productBySlug(slug: String!): ProductResponse!
  products(
    page: Int
    perPage: Int
    search: String
    sortBy: String
    sortOrder: String
  ): ProductListResponse!

  # Plan queries
  plan(id: ID!): PlanResponse!
  planBySlug(slug: String!): PlanResponse!
  plans(
    page: Int
    perPage: Int
    search: String
    sortBy: String
    sortOrder: String
    activeOnly: Boolean
    visibleOnly: Boolean
  ): PlanListResponse!
  plansByProduct(productId: ID!): PlansResponse!

  # Discount queries
  discount(id: ID!): DiscountResponse!
  discounts(
    page: Int
    perPage: Int
    activeOnly: Boolean
    search: String
    sortBy: String
    sortOrder: String
  ): DiscountListResponse!

  # Blog Post queries
  blogPost(id: ID!): BlogPostResponse!
  blogPostBySlug(slug: String!): BlogPostResponse!
  blogPosts(
    page: Int
    perPage: Int
    search: String
    publishedOnly: Boolean
    categoryId: ID
    sortBy: String
    sortOrder: String
  ): BlogPostListResponse!
  searchBlogPosts(
    query: String!
    page: Int
    perPage: Int
    publishedOnly: Boolean
  ): BlogPostListResponse!

  # Category queries
  category(id: ID!): CategoryResponse!
  categoryBySlug(slug: String!): CategoryResponse!
  categories(
    page: Int
    perPage: Int
    search: String
    sortBy: String
    sortOrder: String
  ): CategoryListResponse!

  # Announcement queries
  announcement(id: ID!): AnnouncementResponse!
  announcements(
    page: Int
    perPage: Int
    search: String
    sortBy: String
    sortOrder: String
  ): AnnouncementListResponse!
  activeAnnouncements(
    forCustomers: Boolean
    forFrontend: Boolean
    forUserDashboard: Boolean
  ): ActiveAnnouncementsResponse!
}

# Mutations
type Mutation {
  # Auth mutations
  login(input: LoginInput!): LoginResponse!
  logout(refreshToken: String!): LogoutResponse!
  refreshToken(input: RefreshTokenInput!): RefreshTokenResponse!
  changePassword(input: ChangePasswordInput!): ChangePasswordResponse!
  forgotPassword(email: String!): ForgotPasswordResponse!
  resetPassword(input: ResetPasswordInput!): ResetPasswordResponse!
  verifyEmail(token: String!): VerifyEmailResponse!
  resendVerificationEmail: VerifyEmailResponse!

  # User mutations
  createUser(input: CreateUserInput!): UserResponse!
  updateUser(input: UpdateUserInput!): UserResponse!
  deleteUser(id: ID!): DeleteUserResponse!

  # Bulk operations (admin only)
  bulkDeleteUsers(ids: [ID!]!): BulkOperationResponse!
  bulkBlockUsers(ids: [ID!]!, isBlocked: Boolean!): BulkOperationResponse!

  # Tenant mutations (admin only)
  createTenant(input: CreateTenantInput!): TenantResponse!
  updateTenant(input: UpdateTenantInput!): TenantResponse!
  deleteTenant(id: ID!): DeleteTenantResponse!
  addUserToTenant(input: AddUserToTenantInput!): TenantUserResponse!
  removeUserFromTenant(userId: ID!, tenantId: ID!): DeleteTenantResponse!
  updateUserRole(input: UpdateUserRoleInput!): UpdateUserRoleResponse!
  setDefaultTenant(input: SetDefaultTenantInput!): SetDefaultTenantResponse!

  # Tenant settings mutations
  setTenantSetting(input: SetSettingInput!): TenantSettingResponse!
  deleteTenantSetting(tenantId: ID!, key: String!): DeleteSettingResponse!

  # Product mutations (admin only)
  createProduct(input: CreateProductInput!): ProductResponse!
  updateProduct(input: UpdateProductInput!): ProductResponse!
  deleteProduct(id: ID!): DeleteProductResponse!

  # Plan mutations (admin only)
  createPlan(input: CreatePlanInput!): PlanResponse!
  updatePlan(input: UpdatePlanInput!): PlanResponse!
  deletePlan(id: ID!): DeletePlanResponse!

  # Discount mutations (admin only)
  createDiscount(input: CreateDiscountInput!): DiscountResponse!
  updateDiscount(input: UpdateDiscountInput!): DiscountResponse!
  deleteDiscount(id: ID!): DeleteDiscountResponse!

  # Media mutations
  uploadFile(input: UploadFileInput!): MediaResponse!
  deleteMedia(id: ID!): DeleteMediaResponse!

  # Blog Post mutations
  createBlogPost(input: CreateBlogPostInput!): BlogPostResponse!
  updateBlogPost(input: UpdateBlogPostInput!): BlogPostResponse!
  publishBlogPost(id: ID!): BlogPostResponse!
  unpublishBlogPost(id: ID!): BlogPostResponse!
  deleteBlogPost(id: ID!): DeleteBlogPostResponse!

  # Category mutations
  createCategory(input: CreateCategoryInput!): CategoryResponse!
  updateCategory(input: UpdateCategoryInput!): CategoryResponse!
  deleteCategory(id: ID!): DeleteCategoryResponse!

  # Announcement mutations
  createAnnouncement(input: CreateAnnouncementInput!): AnnouncementResponse!
  updateAnnouncement(input: UpdateAnnouncementInput!): AnnouncementResponse!
  deleteAnnouncement(id: ID!): DeleteAnnouncementResponse!
}
