type ProductList {
  products: [Product!]!
  total: Int!
  page: Int!
  perPage: Int!
}

# Plan list response
type PlanList {
  plans: [Plan!]!
  total: Int!
  page: Int!
  perPage: Int!
}

# Tenant list response
type TenantList {
  tenants: [Tenant!]!
  total: Int!
  page: Int!
  perPage: Int!
}

